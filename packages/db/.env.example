# Copiar a .env y rellenar con el proyecto Supabase NUEVO (no reusar el de tradevision/).
#
# Usa el Connection Pooler (puerto 6543, host "...pooler.supabase.com") en vez del host
# directo (puerto 5432, IPv6-only) salvo que hayas confirmado salida IPv6 real desde esta
# máquina — el proyecto anterior se quedó bloqueado por esto a mitad de una tarea.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/tradevision
