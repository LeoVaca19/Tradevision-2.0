# Copiar a .env y rellenar con el proyecto Supabase (no reusar el de tradevision/).
#
# Usa el Connection Pooler (puerto 6543, host "...pooler.supabase.com") en vez del host
# directo (puerto 5432, IPv6-only) salvo que hayas confirmado salida IPv6 real desde esta
# máquina — el proyecto anterior se quedó bloqueado por esto a mitad de una tarea.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/tradevision

# Supabase Auth — SÓLO URL y anon/publishable key (públicas por diseño, van al navegador).
# Se copian también a apps/web/.env.local (Next sólo expone las NEXT_PUBLIC_*).
# NUNCA pongas aquí ni en el cliente la service_role key.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon o sb_publishable_...>
